# Токен Telegram-бота от @BotFather
BOT_TOKEN=

# Как часто проверять обновления графика (в секундах)
FETCH_INTERVAL_SECONDS=120

# Как часто проверять, не пора ли отправить предупреждение (в секундах)
ALERT_TICK_SECONDS=30

# Как часто проверять Telegram-каналы на срочные перебои/обстрелы (в секундах)
CHANNEL_CHECK_INTERVAL_SECONDS=60

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
